# Foundry project + model (required)
FOUNDRY_PROJECT_ENDPOINT=
AZURE_AI_MODEL_DEPLOYMENT_NAME=
WAYPOINT_GATEWAY_BASE_URL=
WAYPOINT_GATEWAY_SCOPE=https://cognitiveservices.azure.com/.default
WAYPOINT_API_BASE_URL=
WAYPOINT_API_SCOPE=
WAYPOINT_KB_TOOL_NAME=
WAYPOINT_FOUNDRYIQ_RETRIEVAL_MODE=minimal-extractive
# Native upstream endpoint configured behind the project toolbox connection.
# https://<search>.search.windows.net/knowledgebases/<kb>/mcp?api-version=2026-04-01
WAYPOINT_KB_MCP_ENDPOINT=
# Set true only after actual private MCP retrieval, GA tools/list schema,
# citations, model-free KB configuration and gateway-only model access pass.
WAYPOINT_FOUNDRYIQ_GATEWAY_VERIFIED=false

# Optional: switch onto a reasoning / RFT-tuned deployment with no code change.
# MODEL_REASONING_EFFORT=medium

# Optional: record prompt/response text onto GenAI spans so traces are evaluable.
# AZURE_TRACING_GEN_AI_CONTENT_RECORDING_ENABLED=true

# ── Server-side FoundryIQ toolbox ─────────────────────────────────────────────
# Castia resolves TOOLBOX_CONTRACT_TOOLBOX_MCP_ENDPOINT from TOOLBOX_NAME, then
# builds the MCP spec for the contract/policy knowledge-base tool.
TOOLBOX_NAME=contract-toolbox
TOOLBOX_CONTRACT_TOOLBOX_MCP_ENDPOINT=
