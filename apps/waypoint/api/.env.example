# Waypoint API — local development environment (api/.env)
#
# Copy this file to `api/.env` and fill in values for LOCAL runs:
#
#     cp api/.env.example api/.env
#
# `api/.env` is gitignored. It is loaded by app/common/settings.py (env_prefix "APP_") for any
# local launch — a direct `uvicorn` from ./api OR `aspire run` (both run from ./api).
#
# This file affects LOCAL development ONLY. It has no effect on deployed/keystone runs: deployed
# containers ship no `api/.env`, and apphost.cs sets real APP_ONELAKE_*/auth/db env vars which
# always take precedence over a dotenv file in pydantic-settings.

# --- OneLake (Microsoft Fabric) corpus lake -------------------------------------------------------
# Do NOT hardcode the workspace GUID — it is tenant/deploy-specific. Resolve it from the workspace
# display name with the idempotent helper (requires `az login` as a workspace Member):
#
#     ./infra/scripts/onelake-local-env.sh
#
# The helper upserts the four APP_ONELAKE_* values below into api/.env. Re-run it any time the
# workspace is recreated. With these unset, the API degrades gracefully to URI-only document
# metadata (PDF/contract previews show "not available in this environment").
APP_ONELAKE_ACCOUNT_URL=https://onelake.dfs.fabric.microsoft.com
APP_ONELAKE_WORKSPACE=
APP_ONELAKE_LAKEHOUSE=corpus
APP_ONELAKE_CORPUS_PREFIX=Files/corpus

# --- Local auth / docs ----------------------------------------------------------------------------
# Local-only convenience: bypass MSAL bearer validation and expose API docs. Never set in deploy.
APP_LOCAL_AUTH_ENABLED=true
APP_API_DOCS_ENABLED=true

# --- Seed data ------------------------------------------------------------------------------------
# Point the API at a Ledgerfield-generated seed on disk. Leave APP_DEFAULT_SEED_ENABLED=false when a
# seed path/URI is set; flip it to true to load the small built-in demo seed instead.
APP_DEFAULT_SEED_ENABLED=false
# APP_LEDGERFIELD_SEED_PATH=/absolute/path/to/ledgerfield/data/waypoint/waypoint-seed.json

# --- Database -------------------------------------------------------------------------------------
# Connection string for your local Postgres/HorizonDB-compatible database. When you launch the API
# via `aspire run`, Aspire provides this automatically and you can leave it blank here.
# APP_DATABASE_CONNECTION=postgresql://user:password@localhost:5432/waypoint
# Private native BYO deployment (runtime DSN supplied as a secret reference).
APP_REQUIRE_POSTGRES=false
# Deployed API: true, explicit API user-assigned identity client ID and a
# password-free DSN with sslmode=verify-full&sslrootcert=system.
APP_DATABASE_ENTRA_ENABLED=false
APP_DATABASE_ENTRA_CLIENT_ID=
APP_CORPUS_LOCAL_ROOT=
APP_SEED_REQUIRED=false

# --- Hosted release selection --------------------------------------------------------------------
# Pin the promoted numeric version before publishing any newer agent candidate.
# Without a pin, existing development behavior remains unchanged.
# APP_FOUNDRY_ORCHESTRATOR_AGENT_VERSION=4

# --- Telemetry -----------------------------------------------------------------------------------
# A process-level APPLICATIONINSIGHTS_CONNECTION_STRING binding selects direct Azure Monitor export.
# Without it (or when blank), OTEL_EXPORTER_OTLP_* keeps the local Aspire/OTLP behavior.
# OTEL_SERVICE_NAME identifies the API. Only app.* logs are exported, not SDK/root logs.
# FastAPI is instrumented once in main.py; request bodies and AI content are not recorded.
# Service tracing does not capture function arguments unless explicitly opted in.
# These standard telemetry variables must be set in the process environment, not this APP_ dotenv.
